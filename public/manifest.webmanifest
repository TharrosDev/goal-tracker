{
  "name": "THE AMBITION ENGINE",
  "short_name": "AMBITION",
  "description": "A personal operating system for ambition. Local-first: no account, no server, your record stays on your device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0c1018",
  "theme_color": "#0c1018",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Plant a standard", "short_name": "Plant", "url": "/plant", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "The dojo", "short_name": "Dojo", "url": "/dojo", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "The campaign", "short_name": "Campaign", "url": "/campaign", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
